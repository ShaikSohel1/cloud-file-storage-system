# ==============================================================================
# Cloud File Storage System - Backend Environment Configuration (.env.example)
# Copy this file to .env and configure with your credentials. Do not commit .env!
# ==============================================================================

# Server Port (Render sets this dynamically, default: 8080)
PORT=8080

# Active Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs, e.g. Vercel domain)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://[YOUR-DB-HOST]:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.[YOUR-DB-USER]
SPRING_DATASOURCE_PASSWORD="YOUR_DATABASE_PASSWORD"

# Storage Provider: "azure" | "supabase" | "local"
STORAGE_TYPE=azure

# Azure Blob Storage Configuration (Required if STORAGE_TYPE=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=[YOUR_STORAGE_ACCOUNT];AccountKey=[YOUR_ACCOUNT_KEY];EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=cloudstorage

# Supabase Storage Configuration (Optional fallback if STORAGE_TYPE=supabase)
SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_REF].supabase.co
SUPABASE_KEY=[YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY]
SUPABASE_BUCKET=cloudstorage

# Local Storage Configuration (Optional fallback if STORAGE_TYPE=local)
STORAGE_FOLDER_PATH=./uploads/

# JWT Configuration
JWT_SECRET=CloudStorageSecretKeyMustBeAtLeast32BytesLongForHS256Security

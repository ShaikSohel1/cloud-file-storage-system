# PostgreSQL Database Configuration (Supabase Session Pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.[PROJECT_REF]
SPRING_DATASOURCE_PASSWORD=[YOUR_DATABASE_PASSWORD]

# Supabase Storage & Server Configuration (Backend only - never expose service_role key to browser)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]
SUPABASE_BUCKET=cloudstorage

# Supabase Auth Public Anon Key (For frontend or Vite client)
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
